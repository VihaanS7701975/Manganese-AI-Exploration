# Copy to `.env` (never commit `.env`). Only needed for LIVE Copernicus
# satellite downloads via gis_module/. Frontend API base URL is configured
# separately in frontend/.env (see frontend/.env.example).

# Copernicus Data Space Ecosystem credentials (https://dataspace.copernicus.eu).
# Used ONLY by gis_module/copernicus_downloader.py, gis_module/copernicus_search.py
# and gis_module/complete_t45que_safe.py. The SIH demo runs fully offline on
# committed sample data and does NOT need these.
CDSE_USERNAME=
CDSE_PASSWORD=
