# ============================================================
# GIS / Satellite Data
# ============================================================

# Raw Sentinel-1 / Sentinel-2 satellite imagery
data/raw/satellite_images/

# Generated local test scaffolding (scripts/create_test_raster.py output and
# its demo derivatives). Never production data: no production code path
# (backend, src/ml, src/data_processing, frontend) reads these; only the
# standalone demo scripts (create_test_raster, create_feature_dataset,
# gis_module/{gis_processor,cloud_filter,resample}) reference them.
# The real Sentinel-2 SAFE product below is unaffected.
data/raw/test_satellite.tif
data/processed/filtered_test.tif
data/processed/resampled_test.tif
data/processed/satellite_features.csv

# Other raw datasets
data/raw/

# Processed/generated datasets (default-ignore; minimal public demo files
# are re-included below so a fresh clone can run the SIH demo offline).
# The backend only reads: candidate_sites.csv (+ report txt), chennai
# *_sample.csv evidence, SAMPLE_NOTE.json, overlays. Multi-GB/large
# intermediates (ml_features*.csv, manganese_anomalies*.csv,
# mineralization_scores*.csv, *.tif) stay ignored -- regenerate locally.
data/processed/*

# Large raster files
*.jp2
*.tif
*.tiff
*.geotiff
*.img

# Satellite SAFE products
*.SAFE/

# GIS temporary files
*.aux.xml
*.ovr
*.tfw
*.wld


