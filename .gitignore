!data/raw/
!data/raw/satellite_images/
data/raw/satellite_images/*
!data/raw/satellite_images/S2B_MSIL2A_20260625T044659_N0512_R076_T45QUE_20260625T083525.SAFE/
!data/raw/satellite_images/S2B_MSIL2A_20260625T044659_N0512_R076_T45QUE_20260625T083525.SAFE/**
# NOTE (consolidation): upstream only un-ignored SAFE/**/*.jp2 here, which would
# silently drop product metadata (MTD XML, manifest, quicklooks) on a fresh
# `git add`. Widened to the full product tree so the scene stays complete.
# Rasters remain Git-LFS-backed via .gitattributes; see PROVENANCE.md.

# ============================================================
# Public demo data (minimal, small, safe to publish)
# Backend demo reads ONLY these files -- everything else under
# data/processed/ stays ignored (large intermediates, TIFs).
# ============================================================
!data/processed/candidate_sites.csv
!data/processed/candidate_sites_report.txt
!data/processed/chennai/
!data/processed/overlays/
data/processed/chennai/*
!data/processed/chennai/candidate_sites_sample.csv
!data/processed/chennai/candidate_sites_sample_report.txt
!data/processed/chennai/manganese_evidence_sample.csv
!data/processed/chennai/SAMPLE_NOTE.json
data/processed/overlays/*
!data/processed/overlays/t45que_score_overlay.json
# 24 MB pre-rendered overlay PNG for the T45QUE demo. Within GitHub's
# 100 MB file limit; move to Git-LFS if it grows.
!data/processed/overlays/t45que_score_overlay.png
